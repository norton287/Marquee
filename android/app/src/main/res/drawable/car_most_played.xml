<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto icon ("trending_up" from Google's Material Icons, Apache-2.0).
     White and tintable; loaded by the car as android.resource://, so it is
     listed in res/raw/keep.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Drawn at 65% around the centre: Android Auto fills the row's whole
         icon slot, so the symbol looked too big (user, 2026-11-20). -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.65"
        android:scaleY="0.65">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M16,6l2.29,2.29 -4.88,4.88 -4,-4L2,16.59 3.41,18l6,-6 4,4 6.3,-6.29L22,12V6z" />
    </group>
</vector>
